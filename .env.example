# Settings for zabbix-mcp-server, read from environment variables.
# Copy this file to .env for local runs:  cp .env.example .env
# Sections are nested with a double underscore. Lists are comma separated.
# In Kubernetes provide the same variables from Vault (see README, "Kubernetes and Vault").

# --- Zabbix servers (at least one) -------------------------------------------
# <NAME> is any label. Several servers: repeat the block, each with its own URL and token.
# Calls name a server with the `server` parameter; without it ZABBIX_MCP_SERVER__DEFAULT_SERVER
# is used, otherwise the first name alphabetically.
ZABBIX_MCP_ZABBIX_SERVERS__PROD__URL=https://zabbix.example.com
ZABBIX_MCP_ZABBIX_SERVERS__PROD__API_TOKEN=change-me
# ZABBIX_MCP_ZABBIX_SERVERS__PROD__READ_ONLY=true
# ZABBIX_MCP_ZABBIX_SERVERS__PROD__VERIFY_SSL=true
# ZABBIX_MCP_ZABBIX_SERVERS__PROD__TIMEZONE=Europe/London
# ZABBIX_MCP_ZABBIX_SERVERS__STAGING__URL=https://zabbix-staging.example.com
# ZABBIX_MCP_ZABBIX_SERVERS__STAGING__API_TOKEN=change-me

# Per-user tokens instead of a service token: each caller sends their own Zabbix API token
# in this request header, and a request without it is rejected (no API_TOKEN for that server).
# ZABBIX_MCP_ZABBIX_SERVERS__OTHER__URL=https://zabbix-other.example.com
# ZABBIX_MCP_ZABBIX_SERVERS__OTHER__TOKEN_HEADER=X-MCP-Token-UT

# --- MCP server --------------------------------------------------------------
# stdio (default for a local subprocess), http (recommended) or sse.
# The pipeline image already runs http on 0.0.0.0:30030.
# ZABBIX_MCP_SERVER__TRANSPORT=http
# ZABBIX_MCP_SERVER__HOST=127.0.0.1
# ZABBIX_MCP_SERVER__PORT=8080
# ZABBIX_MCP_SERVER__LOG_LEVEL=info

# Bearer token MCP clients must send (Authorization: Bearer <token>).
# Generate one with:  openssl rand -hex 32
# ZABBIX_MCP_SERVER__AUTH_TOKEN=change-me
# Optional: reject the token after this moment (ISO 8601, UTC when no zone is given).
# ZABBIX_MCP_SERVER__AUTH_TOKEN_EXPIRES_AT=2026-12-31T00:00:00Z

# External URL clients use (reverse proxy / Ingress / public DNS name).
# ZABBIX_MCP_SERVER__PUBLIC_URL=https://mcp.example.com

# Tools that can change data in Zabbix are blocked by the list built into the package
# (src/zabbix_mcp/blocked_write_tools.txt). Delete a line there to allow a tool, or use your own file:
# ZABBIX_MCP_SERVER__BLOCKED_TOOLS_FILE=/etc/zabbix-mcp/blocked_write_tools.txt

# Tools offered to the model, chosen by group to save LLM context (README, "Token Budget"):
#   core (16 tools) = status + problems + metrics + audit
#   optional: availability, notifications, analytics, inventory, problems_raw
ZABBIX_MCP_SERVER__TOOLS=core
# ZABBIX_MCP_SERVER__TOOLS=core,availability,analytics
# ZABBIX_MCP_SERVER__DISABLED_TOOLS=analytics

# --- Optional: files holding secrets (Vault Agent / mounted Secret) ----------
# Each file is read like the variable of the same name in lower case.
# Defaults to /vault/secrets when that directory exists.
# ZABBIX_MCP_SECRETS_DIR=/vault/secrets

# --- Optional: PDF report delivery -------------------------------------------
# ZABBIX_MCP_REPORTING__OUTPUT_DIR=/var/reports
# ZABBIX_MCP_REPORTING__EMAIL__ENABLED=true
# ZABBIX_MCP_REPORTING__EMAIL__SMTP_HOST=smtp.example.com
# ZABBIX_MCP_REPORTING__EMAIL__SMTP_PASSWORD=change-me
# ZABBIX_MCP_REPORTING__EMAIL__FROM_ADDRESS=zabbix@example.com
# ZABBIX_MCP_REPORTING__EMAIL__ALLOWED_RECIPIENTS=*@example.com
